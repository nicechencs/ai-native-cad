            "dimension": "length",
            "value": 10.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "upsert_parameter",
      "args": {
        "name": "hub_radius",
        "ir_type": "length",
        "value": {
          "type": "quantity",
          "value": {
            "dimension": "length",
            "value": 22.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "upsert_parameter",
      "args": {
        "name": "hub_height",
        "ir_type": "length",
        "value": {
          "type": "quantity",
          "value": {
            "dimension": "length",
            "value": 24.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "upsert_parameter",
