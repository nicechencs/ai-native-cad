          "param_id": "flange_radius"
        },
        "height": {
          "source": "param",
          "param_id": "flange_height"
        },
        "origin_mm": [
          0.0,
          0.0,
          0.0
        ],
        "axis": [
          0.0,
          0.0,
          1.0
        ]
      }
    },
    {
      "command": "create_primitive_cylinder",
      "args": {
        "node_id": "center_hub",
        "name": "CenterHub",
        "radius": {
          "source": "param",
          "param_id": "hub_radius"
        },
        "height": {
          "source": "param",
          "param_id": "hub_height"
        },
        "origin_mm": [
          0.0,
          0.0,
          0.0
        ],
        "axis": [
          0.0,
          0.0,
          1.0
        ]
      }
    },
    {
      "command": "boolean_solids",
      "args": {
        "node_id": "collar_body",
        "name": "CollarBody",
        "op": "union",
        "target": "flange_disc",
        "tools": [
          "center_hub"
        ]
      }
    },
    {
      "command": "create_hole",
      "args": {
        "node_id": "shaft_bore",
