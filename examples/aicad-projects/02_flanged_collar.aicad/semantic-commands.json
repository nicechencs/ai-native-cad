            "dimension": "length",
            "value": 20.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "create_primitive_cylinder",
      "args": {
        "node_id": "flange_disc",
        "name": "FlangeDisc",
        "radius": {
