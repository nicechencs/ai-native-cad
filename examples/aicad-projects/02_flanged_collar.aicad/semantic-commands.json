          0.0,
          24.0
        ],
        "axis": [
          0.0,
          0.0,
          -1.0
        ],
        "definition": {
          "hole": "generic",
          "diameter": {
            "source": "param",
            "param_id": "bore_diameter"
          },
          "depth": {
            "kind": "through_all"
          },
          "profile": {
            "kind": "simple"
          }
        }
      }
