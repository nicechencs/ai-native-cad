          60.0,
          40.0,
          12.0
        ],
        "axis": [
          0.0,
          0.0,
          -1.0
        ],
        "definition": {
          "hole": "generic",
          "diameter": {
            "source": "param",
            "param_id": "center_bore_d"
          },
          "depth": {
            "kind": "through_all"
          },
          "profile": {
            "kind": "simple"
          }
        }
      }
    },
    {
      "command": "create_hole",
      "args": {
