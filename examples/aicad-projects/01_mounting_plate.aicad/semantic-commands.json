        },
        "depth": {
          "source": "param",
          "param_id": "plate_depth"
        },
        "height": {
          "source": "param",
          "param_id": "plate_thickness"
        },
        "origin_mm": [
          0.0,
          0.0,
          0.0
        ]
      }
    },
    {
      "command": "create_hole",
      "args": {
        "node_id": "center_bore",
        "name": "CenterPilotBore",
