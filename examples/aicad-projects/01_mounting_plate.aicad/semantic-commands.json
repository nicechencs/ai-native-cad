{
  "project_name": "MountingPlate",
  "graph_id": "mounting-plate",
  "commands": [
    {
      "command": "set_design_contract",
      "args": {
        "contract": {
          "part_name": "MountingPlate",
          "summary": "Parametric aluminum mounting plate with center pilot bore and 4 M6 ISO 4762 counterbored corner holes",
          "material": "Al-6061-T6",
          "manufacturing_method": "CNC_3AXIS_MILLING"
        }
      }
    },
    {
      "command": "upsert_parameter",
      "args": {
        "name": "plate_width",
        "ir_type": "length",
        "value": {
          "type": "quantity",
          "value": {
            "dimension": "length",
            "value": 120.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "upsert_parameter",
      "args": {
        "name": "plate_depth",
        "ir_type": "length",
        "value": {
          "type": "quantity",
          "value": {
            "dimension": "length",
            "value": 80.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "upsert_parameter",
      "args": {
        "name": "plate_thickness",
        "ir_type": "length",
        "value": {
          "type": "quantity",
          "value": {
            "dimension": "length",
            "value": 12.0,
            "unit": "mm"
          }
        }
      }
    },
    {
      "command": "upsert_parameter",
      "args": {
        "name": "center_bore_d",
