{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Native CAD Studio",
  "version": "0.1.0",
  "identifier": "dev.ainativecad.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @ai-native-cad/studio-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ai-native-cad/studio-ui build",
    "frontendDist": "../../studio-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI-Native CAD Studio Workbench",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "AI-Native Parametric CAD Workbench powered by Rust and OCCT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/nicechencs/ai-native-cad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
