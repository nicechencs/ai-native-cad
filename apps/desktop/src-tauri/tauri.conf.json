{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Native CAD Studio",
  "version": "0.1.0",
  "identifier": "dev.ainativecad.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @ai-native-cad/studio-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ai-native-cad/studio-ui build",
    "frontendDist": "../../studio-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI-Native CAD Studio Workbench",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
